# Copy this file to .env.secrets and replace the empty/example values locally.
#
# NEVER commit .env.secrets.
# Never paste production keys into issues, pull requests, screenshots, logs,
# chat messages, or job.yaml files.
#
# Precedence:
#   deployment/process environment variables
#   .env.secrets
#   .env

# ---------------------------------------------------------------------------
# Map and search source credentials
# ---------------------------------------------------------------------------

GOOGLE_PLACES_API_KEY=
YANDEX_MAPS_API_KEY=
BRAVE_SEARCH_API_KEY=

# Apple MapKit Server API
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
# Store the PEM text with escaped newlines, for example:
# APPLE_MAPS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_MAPS_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# AI, CAPTCHA, and controlled professional-network tooling
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
TWOCAPTCHA_API_KEY=
# Example only. Include credentials only in the real ignored file.
LINKEDIN_PROXY=

# ---------------------------------------------------------------------------
# Email credentials
# ---------------------------------------------------------------------------

SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Harvester -> NEWAX Core webhook signing
# ---------------------------------------------------------------------------

# Must contain at least 32 random characters when LEAD_SYNC_ENABLED=true.
LEAD_SYNC_WEBHOOK_SECRET=
