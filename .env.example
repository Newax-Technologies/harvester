# Core database
DATABASE_URL=postgresql+asyncpg://postgres:development-only@localhost:5432/opportunity_engine

# LinkedIn Stealth Engine
OPENAI_API_KEY=sk-your-openai-key-here
TWOCAPTCHA_API_KEY=your-2captcha-key-here
