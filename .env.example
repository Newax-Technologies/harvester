# Copy this file to .env for ordinary local configuration.
# Copy .env.secrets.example to .env.secrets for API keys, passwords, private
# keys, proxies, and signing secrets. Never commit either real local file.

# Core database
DATABASE_URL=postgresql+asyncpg://postgres:development-only@localhost:5432/opportunity_engine
TEST_DATABASE_URL=postgresql+asyncpg://opportunity_test:TEST_PASSWORD@127.0.0.1:5432/lead_harvester_test

# Application
APP_ENV=development
ALLOW_DEMO_SEED=false

# Web crawler
USER_AGENT=NEWAXLeadHarvester/1.0 (+https://newax.co/contact)
REQUEST_TIMEOUT_SECONDS=10
CONCURRENCY=5
DELAY_SECONDS=1
MAX_PAGES_PER_DOMAIN=50
MAX_DEPTH=2
MAX_RESPONSE_BYTES=5242880

# Email delivery configuration. SMTP credentials belong in .env.secrets.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=NEWAX

# Development authentication
DEV_AUTH_ENABLED=true
DEV_AUTH_USER=local-admin

# Lead sync webhook (harvester -> core-newax), off by default.
# The signing secret belongs in .env.secrets.
LEAD_SYNC_ENABLED=false
LEAD_SYNC_WEBHOOK_URL=http://localhost:3000/api/integrations/lead-harvester/webhook
LEAD_SYNC_WEBHOOK_TIMEOUT_SECONDS=5.0
LEAD_SYNC_DEFAULT_COUNTRY_CODE=PK

# Daily selection
DAILY_SELECTION_DEFAULT_LIMIT=25
DAILY_SELECTION_RESERVATION_TTL_HOURS=24
DAILY_SELECTION_MIN_SCORE=0
