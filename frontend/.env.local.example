# Copy this file to .env.local (gitignored -- see .gitignore's `*.local`
# pattern) and fill in a value for local development.
#
# VITE_DEV_AUTH_TOKEN authenticates frontend API requests against the
# backend's ServiceCredential dependency (api/dependencies.py::get_current_user).
# Mint one against your own local backend with
# `lead-harvester issue-service-credential --name you --role admin`, ask a
# teammate for a valid token, or set DEV_AUTH_ENABLED=true on your own
# local backend instead of using this token at all. Never commit a real
# value here -- this file only documents the variable name.
VITE_DEV_AUTH_TOKEN=
