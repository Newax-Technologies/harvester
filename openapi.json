      "ManualLeadIn": {
        "properties": {
          "institution_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 2,
            "title": "Institution Name"
          },
          "institution_type": {
            "type": "string",
            "maxLength": 100,
            "title": "Institution Type",
            "description": "school | college | university | clinic | other",
            "default": "school"
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          },
          "operating_status": {
            "type": "string",
            "title": "Operating Status",
            "default": "operational"
          },
          "address": {
            "type": "string",
            "maxLength": 1000,
            "title": "Address",
            "default": ""
          },
          "city": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "City"
          },
          "country": {
            "type": "string",
            "maxLength": 100,
            "title": "Country",
            "default": "Pakistan"
          },
          "country_code": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "Country Code",
            "description": "ISO 3166-1 alpha-2, e.g. 'PK'"
          },
          "contacts": {
            "items": {
              "$ref": "#/components/schemas/ContactEntry"
            },
            "type": "array",
            "minItems": 1,
            "title": "Contacts"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "lead_source_note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Source Note",
            "description": "Where did you find this lead? e.g. 'Cold call', 'Referral from X'"
          }
        },
        "type": "object",
        "required": [
          "institution_name",
          "city",
          "country_code",
          "contacts"
        ],
        "title": "ManualLeadIn"
      },
      "ManualLeadOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
