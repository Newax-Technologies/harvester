# Copy this file to .env.local (gitignored -- see .gitignore's `*.local`
# pattern) and fill in a value for local development.
#
# VITE_DEV_AUTH_TOKEN authenticates frontend API requests against the
# backend's mock-auth dependency (api/dependencies.py::get_current_user),
# which accepts a fixed set of literal tokens ("secret-admin-token",
# "secret-reviewer-token") when DEV_AUTH_ENABLED isn't set. Never commit a
# real value here -- this file only documents the variable name.
VITE_DEV_AUTH_TOKEN=
