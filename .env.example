# Core database
DATABASE_URL=postgresql+asyncpg://postgres:development-only@localhost:5432/opportunity_engine

# LinkedIn Stealth Engine
OPENAI_API_KEY=sk-your-openai-key-here
TWOCAPTCHA_API_KEY=your-2captcha-key-here
LINKEDIN_PROXY=http://user:pass@residential-proxy-host:port

# Email (SMTP) for outreach
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Your Name

# Development
DEV_AUTH_ENABLED=true
DEV_AUTH_USER=local-admin

# Lead sync webhook (harvester -> core-newax), off by default
LEAD_SYNC_ENABLED=false
LEAD_SYNC_WEBHOOK_URL=http://localhost:3000/api/integrations/lead-harvester/webhook
# Deliberately shorter than the 32-character minimum Settings enforces when
# LEAD_SYNC_ENABLED=true, so simply copying this file and flipping that flag
# fails loudly at startup instead of silently shipping a secret that's
# public in this repo's history -- generate and set a real random value.
LEAD_SYNC_WEBHOOK_SECRET=changeme
LEAD_SYNC_WEBHOOK_TIMEOUT_SECONDS=5.0
LEAD_SYNC_DEFAULT_COUNTRY_CODE=PK
